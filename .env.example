# Copy to .env (git-ignored) and adjust as needed. All values have safe defaults;
# nothing here is required to run the SQLite / CI path.

# Data scale: "full" (~2M impressions) or "ci" (~20k, fast). CLI flags override this.
ADPULSE_SCALE=full

# Optional PostgreSQL target (only used if you run the Postgres loader / docker-compose).
# The SQLite path needs none of these.
PGHOST=localhost
PGPORT=5432
PGDATABASE=adpulse
PGUSER=adpulse
PGPASSWORD=change_me_locally
